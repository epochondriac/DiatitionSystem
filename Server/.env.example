# Copy to Server/.env for local runs. On Vercel, set these under Settings -> Environment Variables.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
JWT_SECRET=<long random string: python -c "import secrets; print(secrets.token_urlsafe(48))">
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service role key>
# Comma-separated client URLs allowed to call the API (no trailing slash). Empty = any origin.
ALLOWED_ORIGINS=https://<your-client>.vercel.app
AI_ENABLED=false
OPENAI_API_KEY=
